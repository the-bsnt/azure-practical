for OS artifact
RedHat:RHEL:10-lvm:latest

image structure: Publisher:Offer:SKU:Version
RedHat:RHEL:9_4_gen2:latest

inspection:

- first know publisher

az vm image list-offers \
 --location centralindia \
 --publisher RedHat \
 --output table

- then find sku
  az vm image list-skus \
   --location centralindia \
   --publisher RedHat \
   --offer RHEL \
   --output table
- then find image list in sku
  az vm image list \
   --location centralindia \
   --publisher RedHat \
   --offer RHEL \
   --sku 10-lvm \
   --all \
   --output table;
